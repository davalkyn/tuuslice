# Copy this file to automation/.env and fill it in. Never commit .env or paste its values into chat.

# Telegram: create a NEW token with @BotFather (/revoke the old one first if it was shared).
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user ID (message @userinfobot to get it). Only this user can press buttons.
TELEGRAM_OWNER_ID=
# The community channel where fun posts go. Optional until you want fun posts. Starts with -100.
TELEGRAM_CHANNEL_ID=

# The local model. Ollama is the default. Point this at whatever serves Qwen3 14B on your PC.
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen3:14b

# The local checkout of this website, on the branch that deploys. Scout pushes news here.
REPO_DIR=
PUBLISH_BRANCH=master
SCOUT_GIT_NAME=Scout
SCOUT_GIT_EMAIL=scout@localhost

# Tuning
NEWS_MAX_PER_RUN=3
FUN_POST_INTERVAL_HOURS=6
