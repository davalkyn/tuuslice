---
import { Image } from "astro:assets";
import avatar from "../assets/avatar.png";
import { makePalm, makeSkyline } from "../lib/scene";
import { settings } from "../lib/site";
import Countdown from "./Countdown.astro";
import Icon from "./Icon.astro";
import LiveBadge from "./LiveBadge.astro";

const palmL = makePalm(7, 70);
const palmR = makePalm(21, -55);
const palmR2 = makePalm(42, -20);
const far = makeSkyline(3, { height: 300, downtown: 0.62, density: 0.9, windows: 0.05 });
const near = makeSkyline(11, { height: 320, downtown: 0.18, density: 1.1, windows: 0.09 });
---

<section class="hero" data-hero>
  <div class="hero__scene" aria-hidden="true">
    <div class="hero__sky"></div>
    <div class="hero__sun-wrap" data-depth="0.12" data-scroll="0.32">
      <div class="hero__sun"></div>
    </div>

    <svg class="hero__skyline hero__skyline--far" viewBox={far.viewBox} preserveAspectRatio="xMidYMax slice" data-depth="0.2">
      <path d={far.buildings}></path>
      {far.windows.map((w) => <rect x={w.x} y={w.y} width={w.w} height={w.h} fill={w.c} />)}
    </svg>
    <svg class="hero__skyline hero__skyline--near" viewBox={near.viewBox} preserveAspectRatio="xMidYMax slice" data-depth="0.32">
      <path d={near.buildings}></path>
      {near.windows.map((w) => <rect x={w.x} y={w.y} width={w.w} height={w.h} fill={w.c} />)}
    </svg>

    <div class="hero__ocean"></div>
    <canvas class="hero__canvas" data-hero-canvas></canvas>

    <svg class="hero__palm hero__palm--l" viewBox={palmL.viewBox} data-depth="0.7" data-scroll="-0.08">
      <g class="hero__sway">
        <path class="palm-trunk" d={palmL.trunk}></path>
        <path class="palm-rib" d={palmL.ribs}></path>
        <path class="palm-leaf" d={palmL.leaflets}></path>
        {palmL.nuts.map(([cx, cy]) => <circle cx={cx} cy={cy} r="8" class="palm-nut" />)}
      </g>
    </svg>
    <svg class="hero__palm hero__palm--r" viewBox={palmR.viewBox} data-depth="0.85" data-scroll="-0.1">
      <g class="hero__sway hero__sway--slow">
        <path class="palm-trunk" d={palmR.trunk}></path>
        <path class="palm-rib" d={palmR.ribs}></path>
        <path class="palm-leaf" d={palmR.leaflets}></path>
        {palmR.nuts.map(([cx, cy]) => <circle cx={cx} cy={cy} r="8" class="palm-nut" />)}
      </g>
    </svg>
    <svg class="hero__palm hero__palm--r2" viewBox={palmR2.viewBox} data-depth="0.55">
      <g class="hero__sway">
        <path class="palm-trunk" d={palmR2.trunk}></path>
        <path class="palm-rib" d={palmR2.ribs}></path>
        <path class="palm-leaf" d={palmR2.leaflets}></path>
      </g>
    </svg>

    <div class="hero__haze"></div>
  </div>

  <div class="hero__content wrap" data-hero-content>
    <div class="hero__id">
      <span class="hero__avatar">
        <Image src={avatar} alt="tuuslice avatar: a faceless silhouette with glowing eyes" width={160} height={160} loading="eager" fetchpriority="high" />
      </span>
      <p class="eyebrow">Road to Leonida · GTA VI hub</p>
    </div>

    <h1 class="hero__word display" data-split>
      {settings.brand.split("").map((ch, i) => <span style={`--i:${i}`}>{ch}</span>)}
    </h1>

    <p class="hero__tagline">{settings.tagline}</p>

    <Countdown />

    <div class="hero__ctas btn-row">
      <LiveBadge size="lg" />
      <a class="btn btn--ghost btn--lg" href={settings.socials.discord} target="_blank" rel="noopener noreferrer">
        <Icon name="discord" /> Join the Discord
      </a>
      <a class="btn btn--ghost btn--lg hero__news" href="/news/">
        Latest news <Icon name="arrow" />
      </a>
    </div>
  </div>

  <a href="#home-start" class="hero__cue" aria-label="Scroll to content">
    <span>Scroll</span>
    <span class="hero__cue-line"></span>
  </a>
</section>

<style>
  .hero {
    --horizon: 74%;
    position: relative;
    min-height: max(680px, 100svh);
    display: flex;
    align-items: center;
    overflow: hidden;
    isolation: isolate;
  }

  .hero__scene {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero__sky {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60% 40% at 70% var(--horizon), rgba(255, 179, 71, 0.55), transparent 70%),
      linear-gradient(180deg, #0a0612 0%, #160a2b 22%, #34104a 42%, #7a1858 56%, #d42a64 66%, #ff6a45 72%, #ffb347 var(--horizon), #ffb347 100%);
    background-size: 100% 100%, 100% 115%;
    background-repeat: no-repeat;
    background-position: 0 0, 0 0;
    animation: sky-breathe 16s ease-in-out infinite;
  }
  @keyframes sky-breathe {
    50% { background-position: 0 0, 0 40%; filter: saturate(1.15) hue-rotate(-6deg); }
  }

  .hero__sun-wrap {
    position: absolute;
    left: 70%;
    bottom: calc(100% - var(--horizon));
    width: min(44vw, 520px);
    aspect-ratio: 1;
    translate: -50% 38%;
    will-change: transform;
  }
  .hero__sun {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: linear-gradient(180deg, #fff1b8 0%, #ffd56b 22%, #ffb347 40%, #ff7a3d 62%, #ff2d87 100%);
    box-shadow: 0 0 80px rgba(255, 179, 71, 0.55), 0 0 200px rgba(255, 122, 61, 0.45), 0 0 340px rgba(255, 45, 135, 0.35);
    -webkit-mask: linear-gradient(180deg, #000 0 48%, transparent 48% 50%, #000 50% 57%, transparent 57% 60%, #000 60% 66%, transparent 66% 70%, #000 70% 75%, transparent 75% 80%, #000 80% 84%, transparent 84% 90%, #000 90%);
    mask: linear-gradient(180deg, #000 0 48%, transparent 48% 50%, #000 50% 57%, transparent 57% 60%, #000 60% 66%, transparent 66% 70%, #000 70% 75%, transparent 75% 80%, #000 80% 84%, transparent 84% 90%, #000 90%);
    animation: sun-glow 6s ease-in-out infinite;
  }
  @keyframes sun-glow {
    50% { filter: brightness(1.08) saturate(1.1); }
  }

  .hero__skyline {
    position: absolute;
    left: -2%;
    width: 104%;
    bottom: calc(100% - var(--horizon) - 1px);
    will-change: transform;
  }
  .hero__skyline--far {
    height: clamp(120px, 20vh, 220px);
    fill: #4a1452;
    opacity: 0.75;
  }
  .hero__skyline--near {
    height: clamp(110px, 17vh, 190px);
    fill: #1c0927;
  }
  .hero__skyline rect { opacity: 0.85; }

  .hero__ocean {
    position: absolute;
    left: 0;
    right: 0;
    top: var(--horizon);
    bottom: 0;
    background:
      radial-gradient(40% 60% at 70% 0%, rgba(255, 122, 61, 0.45), transparent 70%),
      linear-gradient(180deg, #5a1650 0%, #2a0d3c 35%, #120822 70%, var(--night) 100%);
  }

  .hero__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero__palm {
    position: absolute;
    bottom: -2%;
    fill: #070310;
    will-change: transform;
  }
  .hero__palm--l {
    left: -7%;
    height: 96%;
    max-height: 980px;
  }
  .hero__palm--r {
    right: -8%;
    height: 88%;
    max-height: 900px;
  }
  .hero__palm--r2 {
    right: 9%;
    height: 58%;
    fill: #12061c;
    opacity: 0.95;
  }
  .palm-rib {
    fill: none;
    stroke: currentColor;
    stroke-width: 6;
    stroke-linecap: round;
  }
  .palm-leaf {
    fill: none;
    stroke: currentColor;
    stroke-width: 3.4;
    stroke-linecap: round;
  }
  .hero__palm { color: #070310; }
  .hero__palm--r2 { color: #12061c; }

  .hero__sway {
    transform-origin: 50% 100%;
    transform-box: view-box;
    animation: sway 7s ease-in-out infinite;
  }
  .hero__sway--slow { animation-duration: 9s; animation-delay: -2s; }
  @keyframes sway {
    0%, 100% { transform: rotate(-0.8deg); }
    50% { transform: rotate(0.9deg); }
  }

  .hero__haze {
    position: absolute;
    inset: auto 0 0 0;
    height: 30%;
    background: linear-gradient(180deg, transparent, rgba(10, 6, 18, 0.65) 60%, var(--night));
  }

  /* content */
  .hero__content {
    position: relative;
    padding-top: calc(var(--nav-h) + 2rem);
    padding-bottom: 7rem;
    will-change: transform, opacity;
  }
  .hero__content::before {
    content: "";
    position: absolute;
    inset: 0 auto 0 -10%;
    width: 75%;
    z-index: -1;
    background: radial-gradient(60% 55% at 30% 50%, rgba(10, 6, 18, 0.55), transparent 75%);
    pointer-events: none;
  }
  .hero__id { display: flex; align-items: center; gap: 1rem; }
  .hero__avatar {
    position: relative;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    padding: 3px;
    flex-shrink: 0;
  }
  .hero__avatar::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--grad-neon);
    animation: spin-angle 5s linear infinite;
    box-shadow: 0 0 30px rgba(255, 45, 135, 0.5);
  }
  @keyframes spin-angle { to { --angle: 360deg; } }
  .hero__avatar img {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--night);
    background: var(--night);
  }

  .hero__word {
    margin-top: 1rem;
    font-size: clamp(4.4rem, 17vw, 12.5rem);
    line-height: 0.86;
    letter-spacing: 0.005em;
    color: transparent;
    filter: drop-shadow(0 0 22px rgba(255, 45, 135, 0.45)) drop-shadow(0 8px 30px rgba(10, 6, 18, 0.6));
    display: flex;
  }
  .hero__word span {
    display: inline-block;
    background: linear-gradient(180deg, #fff6e8 0%, #ffd6a0 30%, #ff9a5a 58%, #ff2d87 100%);
    -webkit-background-clip: text;
    background-clip: text;
    animation: letter-in 1.1s var(--ease) both;
    animation-delay: calc(120ms + var(--i) * 55ms);
  }
  @keyframes letter-in {
    from { opacity: 0; transform: translateY(40%) rotate(4deg); filter: blur(8px); }
  }

  .hero__tagline {
    margin-top: 1.2rem;
    max-width: 46ch;
    font-size: clamp(1.05rem, 2.1vw, 1.3rem);
    color: #eadcf2;
    text-shadow: 0 2px 18px rgba(10, 6, 18, 0.8);
    animation: fade-up 1s var(--ease) 0.5s both;
  }
  .hero__ctas { margin-top: 2rem; animation: fade-up 1s var(--ease) 0.8s both; }
  .hero :global(.countdown) { animation: fade-up 1s var(--ease) 0.65s both; }

  @keyframes fade-up {
    from { opacity: 0; transform: translateY(18px); }
  }

  .hero__cue {
    position: absolute;
    left: 50%;
    bottom: 1.6rem;
    translate: -50% 0;
    display: grid;
    justify-items: center;
    gap: 0.5rem;
    color: rgba(255, 255, 255, 0.7);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .hero__cue-line {
    width: 1px;
    height: 38px;
    background: linear-gradient(180deg, var(--pink-hot), transparent);
    animation: cue 2.2s var(--ease) infinite;
    transform-origin: top;
  }
  @keyframes cue {
    0% { transform: scaleY(0); opacity: 1; }
    60% { transform: scaleY(1); opacity: 1; }
    100% { transform: scaleY(1); opacity: 0; }
  }

  @media (max-width: 900px) {
    .hero { --horizon: 78%; }
    .hero__sun-wrap { left: 62%; width: min(78vw, 440px); translate: -50% 45%; }
    .hero__palm--l { left: -24%; height: 70%; }
    .hero__palm--r { right: -28%; height: 66%; }
    .hero__palm--r2 { display: none; }
    .hero__content { padding-bottom: 9rem; }
  }
  @media (max-width: 560px) {
    .hero { --horizon: 87%; }
    .hero__sun-wrap { left: 68%; width: 64vw; translate: -50% 52%; }
    .hero__skyline--far { height: 90px; }
    .hero__skyline--near { height: 80px; }
    .hero__content { padding-bottom: 6.5rem; }
    .hero__ctas :global(.btn), .hero__ctas :global(.live-badge) { flex: 1 1 100%; justify-content: center; }
    .hero__news { display: none; }
    .hero__cue { display: none; }
  }
</style>
