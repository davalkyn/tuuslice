---
import { settings } from "../lib/site";
import Icon from "./Icon.astro";

interface Props {
  size?: "sm" | "lg";
}
const { size = "sm" } = Astro.props;
---

<a
  class:list={["live-badge", `live-badge--${size}`]}
  href={settings.socials.kick}
  target="_blank"
  rel="noopener noreferrer"
  data-live-badge
>
  <span class="live-badge__dot" aria-hidden="true"></span>
  <Icon name="kick" size={size === "lg" ? 18 : 15} class="live-badge__icon" />
  <span class="live-badge__label" data-live-label>Watch on Kick</span>
  <span class="live-badge__viewers" data-live-viewers hidden></span>
</a>

<style>
  .live-badge {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 40px;
    padding: 0.45rem 1rem;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-decoration: none;
    white-space: nowrap;
    color: #06120a;
    background: linear-gradient(120deg, #53fc18, #2bd96b);
    box-shadow: 0 8px 24px -10px rgba(83, 252, 24, 0.6);
    transition: transform 0.4s var(--ease-spring), box-shadow 0.4s var(--ease);
  }
  .live-badge:hover {
    transform: translateY(-2px) scale(1.03);
    box-shadow: 0 12px 30px -8px rgba(83, 252, 24, 0.65), 0 0 28px rgba(83, 252, 24, 0.45);
  }
  .live-badge--lg { min-height: 52px; padding: 0.8rem 1.5rem; font-size: 1rem; }
  .live-badge__dot { display: none; }
  .live-badge__viewers {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.75em;
    opacity: 0.85;
  }

  .live-badge:global(.is-live) {
    color: #fff;
    background: linear-gradient(120deg, #ff3b4f, #ff2d87);
    box-shadow: 0 8px 24px -8px rgba(255, 59, 79, 0.7), 0 0 30px rgba(255, 45, 135, 0.45);
    animation: live-pulse 2s ease-in-out infinite;
  }
  .live-badge:global(.is-live) .live-badge__dot {
    display: block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.7);
    animation: live-ping 1.6s ease-out infinite;
  }
  .live-badge:global(.is-live) :global(.live-badge__icon) { display: none; }

  @keyframes live-pulse {
    50% { box-shadow: 0 8px 30px -6px rgba(255, 59, 79, 0.85), 0 0 46px rgba(255, 45, 135, 0.6); }
  }
  @keyframes live-ping {
    0% { box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.7); }
    80%, 100% { box-shadow: 0 0 0 9px rgba(255, 255, 255, 0); }
  }

  @media (max-width: 420px) {
    .live-badge--sm { padding-inline: 0.8rem; font-size: 0.8rem; }
  }
</style>
