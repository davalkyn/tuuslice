---
import { Image } from "astro:assets";
import avatar from "../assets/avatar.png";
import { NAV, settings } from "../lib/site";
import Icon from "./Icon.astro";
import LiveBadge from "./LiveBadge.astro";

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href) || (href === "/guides/" && path.startsWith("/tips/"));
---

<header class="nav" data-nav>
  <div class="nav__inner wrap">
    <a href="/" class="nav__brand" aria-label="tuuslice home">
      <span class="nav__avatar">
        <Image src={avatar} alt="" width={72} height={72} loading="eager" />
      </span>
      <span class="nav__word">{settings.brand}</span>
    </a>

    <nav class="nav__links" aria-label="Main">
      {
        NAV.map((item) => (
          <a href={item.href} class="nav__link" aria-current={isActive(item.href) ? "page" : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="nav__actions">
      <LiveBadge />
      <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
        <span class="sr-only">Open menu</span>
        <span class="nav__burger" aria-hidden="true"><span></span><span></span><span></span></span>
      </button>
    </div>
  </div>
</header>

<div class="mmenu" id="mobile-menu" data-menu hidden>
  <nav class="mmenu__links" aria-label="Mobile">
    <a href="/" class="mmenu__link" style="--i:0">Home</a>
    {
      NAV.map((item, i) => (
        <a href={item.href} class="mmenu__link" style={`--i:${i + 1}`} aria-current={isActive(item.href) ? "page" : undefined}>
          {item.label}
        </a>
      ))
    }
    <a href="/support/" class="mmenu__link" style={`--i:${NAV.length + 1}`}>Support</a>
  </nav>
  <div class="mmenu__foot">
    <a class="btn btn--kick" href={settings.socials.kick} target="_blank" rel="noopener noreferrer">
      <Icon name="kick" size={18} /> Watch on Kick
    </a>
    <a class="btn btn--ghost" href={settings.socials.discord} target="_blank" rel="noopener noreferrer">
      <Icon name="discord" size={18} /> Discord
    </a>
  </div>
</div>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    height: var(--nav-h);
    view-transition-name: site-nav;
    transition: background 0.4s var(--ease), box-shadow 0.4s var(--ease), backdrop-filter 0.4s var(--ease);
  }
  .nav:global(.nav--scrolled) {
    background: rgba(10, 6, 18, 0.72);
    backdrop-filter: blur(18px) saturate(1.4);
    -webkit-backdrop-filter: blur(18px) saturate(1.4);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.06), 0 10px 40px -20px rgba(255, 45, 135, 0.4);
  }
  .nav__inner {
    height: 100%;
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  .nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    flex-shrink: 0;
  }
  .nav__avatar {
    position: relative;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    padding: 2px;
    background: var(--grad-sunset);
    box-shadow: 0 0 18px rgba(255, 45, 135, 0.45);
    transition: transform 0.5s var(--ease-spring), box-shadow 0.4s var(--ease);
  }
  .nav__avatar img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    background: var(--night);
  }
  .nav__brand:hover .nav__avatar {
    transform: rotate(-8deg) scale(1.08);
    box-shadow: 0 0 26px rgba(255, 45, 135, 0.7), 0 0 50px rgba(255, 122, 61, 0.35);
  }
  .nav__word {
    font-family: var(--font-display);
    font-size: 1.45rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    background: var(--grad-sunset);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: drop-shadow(0 0 10px rgba(255, 45, 135, 0.35));
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: 0.2rem;
    margin-inline: auto;
  }
  .nav__link {
    position: relative;
    padding: 0.5rem 0.8rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-dim);
    text-decoration: none;
    border-radius: 999px;
    transition: color 0.3s var(--ease), text-shadow 0.3s var(--ease);
  }
  .nav__link::after {
    content: "";
    position: absolute;
    left: 0.8rem;
    right: 0.8rem;
    bottom: 0.25rem;
    height: 2px;
    border-radius: 2px;
    background: var(--grad-sunset);
    box-shadow: 0 0 10px var(--glow-pink), 0 0 20px var(--glow-orange);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.45s var(--ease);
  }
  .nav__link:hover,
  .nav__link[aria-current="page"] {
    color: #fff;
    text-shadow: 0 0 14px rgba(255, 95, 168, 0.6);
  }
  .nav__link:hover::after,
  .nav__link[aria-current="page"]::after {
    transform: scaleX(1);
  }

  .nav__actions {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-left: auto;
  }
  .nav__links + .nav__actions { margin-left: 0; }

  .nav__toggle {
    display: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--border-strong);
    background: rgba(255, 255, 255, 0.04);
    align-items: center;
    justify-content: center;
    transition: border-color 0.3s, box-shadow 0.3s;
  }
  .nav__toggle:hover { border-color: var(--pink-hot); box-shadow: 0 0 20px rgba(255, 45, 135, 0.35); }
  .nav__burger { position: relative; width: 18px; height: 12px; }
  .nav__burger span {
    position: absolute;
    left: 0;
    height: 2px;
    width: 100%;
    border-radius: 2px;
    background: currentColor;
    transition: transform 0.45s var(--ease), opacity 0.3s, top 0.45s var(--ease);
  }
  .nav__burger span:nth-child(1) { top: 0; }
  .nav__burger span:nth-child(2) { top: 5px; width: 70%; }
  .nav__burger span:nth-child(3) { top: 10px; }
  .nav__toggle[aria-expanded="true"] .nav__burger span:nth-child(1) { top: 5px; transform: rotate(45deg); }
  .nav__toggle[aria-expanded="true"] .nav__burger span:nth-child(2) { opacity: 0; }
  .nav__toggle[aria-expanded="true"] .nav__burger span:nth-child(3) { top: 5px; transform: rotate(-45deg); }

  /* mobile menu */
  .mmenu {
    position: fixed;
    inset: 0;
    z-index: 90;
    padding: calc(var(--nav-h) + 1.5rem) var(--gutter) 2rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background:
      radial-gradient(80% 50% at 50% 110%, rgba(255, 122, 61, 0.35), transparent 70%),
      radial-gradient(70% 50% at 50% 100%, rgba(255, 45, 135, 0.35), transparent 70%),
      var(--night);
    opacity: 0;
    transition: opacity 0.4s var(--ease);
    overflow-y: auto;
  }
  .mmenu[hidden] { display: none; }
  .mmenu:global(.mmenu--open) { opacity: 1; }
  .mmenu__links { display: grid; gap: 0.2rem; }
  .mmenu__link {
    font-family: var(--font-display);
    font-size: clamp(2.1rem, 9vw, 3rem);
    text-transform: uppercase;
    line-height: 1.15;
    text-decoration: none;
    color: var(--text);
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 0.5s var(--ease), transform 0.5s var(--ease), color 0.3s;
    transition-delay: calc(var(--i) * 45ms);
  }
  .mmenu:global(.mmenu--open) .mmenu__link { opacity: 1; transform: none; }
  .mmenu__link[aria-current="page"],
  .mmenu__link:hover {
    background: var(--grad-sunset);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .mmenu__foot { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-top: 2rem; }

  @media (max-width: 1080px) {
    .nav__links { display: none; }
    .nav__toggle { display: inline-flex; }
    .nav__actions { margin-left: auto; }
  }
  @media (max-width: 420px) {
    .nav__word { font-size: 1.25rem; }
  }
</style>
