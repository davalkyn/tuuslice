---
import Icon from "./Icon.astro";

interface Props {
  url: string;
  title: string;
}
const { url, title } = Astro.props;
const u = encodeURIComponent(url);
const t = encodeURIComponent(title);
const targets = [
  { key: "whatsapp", label: "WhatsApp", href: `https://wa.me/?text=${t}%20${u}` },
  { key: "telegram", label: "Telegram", href: `https://t.me/share/url?url=${u}&text=${t}` },
  { key: "x", label: "X", href: `https://x.com/intent/post?text=${t}&url=${u}` },
  { key: "reddit", label: "Reddit", href: `https://www.reddit.com/submit?url=${u}&title=${t}` },
];
---

<div class="share">
  <span class="share__label mono">Share</span>
  {
    targets.map((s) => (
      <a class="share__btn" href={s.href} target="_blank" rel="noopener noreferrer" aria-label={`Share on ${s.label}`}>
        <Icon name={s.key} size={18} />
      </a>
    ))
  }
  <button class="share__btn share__copy" type="button" data-copy={url} aria-label="Copy link">
    <Icon name="link" size={18} />
    <span class="share__copied" data-copy-label>Copy link</span>
  </button>
</div>

<style>
  .share { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; }
  .share__label {
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--text-faint);
    margin-right: 0.4rem;
  }
  .share__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 42px;
    min-width: 42px;
    justify-content: center;
    padding: 0 0.7rem;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    background: rgba(255, 255, 255, 0.03);
    color: var(--text-dim);
    transition: all 0.35s var(--ease);
  }
  .share__btn:hover {
    color: #fff;
    border-color: var(--pink-hot);
    background: rgba(255, 45, 135, 0.14);
    box-shadow: 0 0 22px rgba(255, 45, 135, 0.4);
    transform: translateY(-2px);
  }
  .share__copied { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.08em; }
  .share__copy:global(.copied) { color: #0a0612; background: var(--teal); border-color: var(--teal); }
</style>
