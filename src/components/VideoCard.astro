---
import { parseVideo, type Video } from "../lib/content";
import { formatDate } from "../lib/site";
import Icon from "./Icon.astro";

interface Props {
  video: Video;
}
const { video } = Astro.props;
const { title, platform, url, pubDate } = video.data;
const parsed = parseVideo(url, platform);

let embed = "";
let thumb = "";
if (platform === "youtube" && parsed?.id) {
  embed = `https://www.youtube-nocookie.com/embed/${parsed.id}?autoplay=1&rel=0`;
  thumb = `https://i.ytimg.com/vi/${parsed.id}/hqdefault.jpg`;
} else if (platform === "tiktok" && parsed?.id) {
  embed = `https://www.tiktok.com/embed/v2/${parsed.id}`;
}
const vertical = platform === "tiktok" || Boolean(parsed?.short);
const platformLabel = { youtube: "YouTube", tiktok: "TikTok", kick: "Kick" }[platform];
---

<article class:list={["video glow-card", { "video--vertical": vertical }]}>
  <div class="video__media">
    {
      embed ? (
        <button class="video__facade" type="button" data-embed={embed} data-title={title} data-frame-class="video__frame" aria-label={`Play: ${title}`}>
          {thumb ? <img src={thumb} alt="" loading="lazy" decoding="async" /> : <span class={`video__bg video__bg--${platform}`} />}
          <span class="video__play">
            <Icon name="play" size={26} />
          </span>
        </button>
      ) : (
        <a class="video__facade" href={url} target="_blank" rel="noopener noreferrer" aria-label={`Watch on ${platformLabel}: ${title}`}>
          <span class={`video__bg video__bg--${platform}`} />
          <span class="video__play">
            <Icon name="external" size={24} />
          </span>
        </a>
      )
    }
  </div>
  <div class="video__body">
    <p class="video__meta mono">
      <Icon name={platform} size={14} /> {platformLabel} · <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
    </p>
    <h3 class="video__title">
      <a href={url} target="_blank" rel="noopener noreferrer">{title}</a>
    </h3>
  </div>
</article>

<style>
  .video { overflow: hidden; display: flex; flex-direction: column; }
  .video__media { position: relative; aspect-ratio: 16 / 9; background: #0d0716; }
  .video--vertical .video__media { aspect-ratio: 9 / 16; max-height: 560px; }
  .video__facade {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    color: #fff;
    overflow: hidden;
  }
  .video__facade img, .video__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease), filter 0.5s var(--ease);
  }
  .video__bg--youtube, .video__bg--kick { background: linear-gradient(160deg, #1c0b2e, #7a1858 60%, #ff7a3d); }
  .video__bg--tiktok { background: linear-gradient(160deg, #0a1426, #123a5a 55%, #ff2d87); }
  .video__bg--kick { background: linear-gradient(160deg, #06120a, #1f5f12 60%, #53fc18); }
  .video__play {
    position: relative;
    display: grid;
    place-items: center;
    width: 68px;
    height: 68px;
    border-radius: 50%;
    background: rgba(10, 6, 18, 0.55);
    border: 1px solid rgba(255, 255, 255, 0.35);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transition: all 0.45s var(--ease-spring);
  }
  .video:hover .video__play {
    transform: scale(1.12);
    background: var(--grad-sunset);
    border-color: transparent;
    box-shadow: 0 0 40px var(--glow-pink);
  }
  .video:hover .video__facade img, .video:hover .video__bg { transform: scale(1.06); filter: saturate(1.2); }
  :global(.video__frame) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .video__body { padding: 1rem 1.15rem 1.2rem; display: grid; gap: 0.45rem; }
  .video__meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
  .video__title { font-size: 1.2rem; line-height: 1.12; }
  .video__title a { text-decoration: none; color: inherit; }
  .video__title a:hover { color: var(--pink-hot); }
</style>
