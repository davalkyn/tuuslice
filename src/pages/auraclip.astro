---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import PageHead from "../components/PageHead.astro";
import SectionHead from "../components/SectionHead.astro";
import { settings } from "../lib/site";

const a = settings.auraclip;
const steps = [
  { n: "1", title: "Import", text: "Paste a YouTube or Twitch link, or drop in an MP4, MKV or MOV file of your GTA 6 stream." },
  { n: "2", title: "Find the moments", text: "Speech, laughter, audio spikes, scene cuts and Twitch chat are scored on one timeline, so the best moments float to the top." },
  { n: "3", title: "Edit automatically", text: "Smart vertical crop, word-by-word captions, your logo or Kick name, filters and music." },
  { n: "4", title: "Approve and post", text: "Review the captions, then press Post to TikTok, YouTube Shorts or X. Nothing goes live until you say so." },
];
const trust = [
  { icon: "shield", title: "Runs on your PC", text: "Analysis and rendering happen on your own computer, not on a server." },
  { icon: "eye", title: "Nothing uploaded to us", text: "Your videos are never uploaded to us. Only the clips you choose to post leave your machine." },
  { icon: "check", title: "You stay in control", text: "Every clip waits for your approval before it is posted anywhere." },
];
---

<BaseLayout
  title="AuraClip: clip GTA 6 streams locally"
  description="AuraClip is my AI stream clipper for Windows. It finds the best moments, cuts captioned vertical clips, and runs on your own PC, so your footage isn't uploaded to us."
>
  <PageHead
    eyebrow="My clipping tool"
    title="Clip GTA 6 fast."
    accent="Keep it local."
    lead="Launch week means hours of footage. AuraClip turns a long stream into captioned vertical clips for TikTok, Shorts and X, and the heavy work runs on your own PC."
  >
    <div class="btn-row">
      <a class="btn btn--lg" href={a.trial} target="_blank" rel="noopener noreferrer" data-magnetic>
        <Icon name="external" /> Free 7-day trial
      </a>
      <a class="btn btn--ghost btn--lg" href={a.site} target="_blank" rel="noopener noreferrer">Visit getauraclip.pages.dev</a>
    </div>
    <p class="faint small">Windows 10 or 11, 64-bit. No card or account for the trial. Mac version: not yet.</p>
  </PageHead>

  <section class="wrap section" style="padding-top: 0">
    <div class="grid grid--3" data-reveal-group>
      {
        trust.map((t) => (
          <div class="card glow-card">
            <span class="card__icon"><Icon name={t.icon} size={22} /></span>
            <h2 class="h3">{t.title}</h2>
            <p class="muted">{t.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="wrap section">
    <SectionHead eyebrow="How it works" title="Stream in," accent="clips out" />
    <ol class="steps" data-reveal-group>
      {
        steps.map((s) => (
          <li class="step glow-card">
            <span class="step__n display">{s.n}</span>
            <h3 class="h3">{s.title}</h3>
            <p class="muted">{s.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="wrap section">
    <div class="buy glow-card glow-card--static" data-reveal>
      <div>
        <p class="eyebrow">Try it, then decide</p>
        <h2 class="h2">Start with the <span class="grad-text">free trial</span></h2>
        <p class="muted">
          The trial has every feature for 7 days. The 2-Month License is one payment for 60 days on up to 2 PCs, with free
          updates while it's active. The price is shown in your currency at checkout.
        </p>
      </div>
      <div class="btn-row">
        <a class="btn btn--lg" href={a.trial} target="_blank" rel="noopener noreferrer">Download free trial</a>
        <a class="btn btn--ghost btn--lg" href={a.buy} target="_blank" rel="noopener noreferrer">Buy a license</a>
      </div>
    </div>
    <p class="notice" data-reveal>
      <Icon name="info" />
      <span>
        AuraClip is my own tool, so this is a promotion. The details above come from the AuraClip site; check it for current
        requirements and pricing. Questions: <a href={`mailto:${a.support}`}>{a.support}</a>. Not affiliated with Rockstar
        Games, Kick, Twitch, TikTok, YouTube or X.
      </span>
    </p>
  </section>
</BaseLayout>

<style>
  .small { font-size: 0.85rem; }
  .card { padding: 1.5rem; display: grid; gap: 0.6rem; align-content: start; }
  .card__icon {
    display: grid; place-items: center; width: 46px; height: 46px; border-radius: 14px;
    background: rgba(34, 228, 217, 0.12); color: var(--teal); box-shadow: 0 0 0 1px rgba(34, 228, 217, 0.35);
  }
  .steps { list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); gap: 1rem; }
  .step { padding: 1.4rem; display: grid; gap: 0.5rem; align-content: start; }
  .step__n { font-size: 2.6rem; line-height: 1; background: var(--grad-sunset); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .buy { display: grid; grid-template-columns: 1.4fr 1fr; gap: 2rem; align-items: center; padding: clamp(1.6rem, 4vw, 2.75rem); margin-bottom: 1.25rem; }
  .buy > div:first-child { display: grid; gap: 0.8rem; }
  @media (max-width: 820px) { .buy { grid-template-columns: 1fr; } }
</style>
