---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EmptyState from "../../components/EmptyState.astro";
import PageHead from "../../components/PageHead.astro";
import PostCard from "../../components/PostCard.astro";
import { getPosts } from "../../lib/content";

const posts = await getPosts("blog");
---

<BaseLayout title="Blog" description="Updates from tuuslice: stream plans, community news and behind-the-scenes on the road to GTA 6.">
  <PageHead eyebrow="From the channel" title="The" accent="blog" lead="Stream plans, community updates and the occasional rant. Straight from me." />
  <section class="wrap section" style="padding-top: 0">
    {
      posts.length ? (
        <div class="grid grid--3" data-reveal-group>
          {posts.map((post) => (
            <PostCard post={post} morph headingLevel="h2" />
          ))}
        </div>
      ) : (
        <EmptyState title="No posts yet" text="The first blog post is on its way." />
      )
    }
  </section>
</BaseLayout>
