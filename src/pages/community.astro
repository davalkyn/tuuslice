---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import PageHead from "../components/PageHead.astro";
import SectionHead from "../components/SectionHead.astro";
import { formatNumber, settings } from "../lib/site";

const channels = [
  { name: "#news", text: "Official GTA 6 news only, mirrored from the Telegram feed." },
  { name: "#rumor-check", text: "Every rumor tagged verified or unverified. Bring receipts." },
  { name: "#clips", text: "Your best moments and stream highlights." },
  { name: "#performance-tracker", text: "Series S, Series X and PS5 reports from real players." },
  { name: "#lfg", text: "Find a crew for co-op, heists and launch-night sessions." },
  { name: "#spoilers", text: "Opt-in role only. Story talk lives here and nowhere else." },
];
const rules = [
  "No story spoilers outside #spoilers for the first two weeks after launch.",
  "Leaks and rumors go in #rumor-check, clearly labeled.",
  "No piracy, mod menus or account selling.",
  "Be decent. Banter is fine, harassment isn't.",
];
const { discordMembers, telegramMembers } = settings.stats;
---

<BaseLayout title="Community" description="Join the tuuslice GTA 6 community: Discord for LFG, clips and the rumor check, and Telegram for instant news alerts.">
  <PageHead
    eyebrow="Community"
    title="Find your"
    accent="crew"
    lead="Telegram is where the news lands first. Discord is where we hang out, find co-op partners and talk GTA 6 without spoiling anyone."
  />

  <section class="wrap">
    <div class="duo-grid" data-reveal-group>
      <article class="hub glow-card hub--discord">
        <span class="hub__icon"><Icon name="discord" size={30} /></span>
        <h2 class="h2">Discord</h2>
        {discordMembers > 0 && <p class="hub__stat mono">{formatNumber(discordMembers)} members</p>}
        <p class="muted">LFG for co-op, launch-night events, the Series S performance tracker and a spoiler channel behind an opt-in role.</p>
        <a class="btn btn--lg" href={settings.socials.discord} target="_blank" rel="noopener noreferrer" data-magnetic>
          <Icon name="discord" /> Join the server
        </a>
      </article>
      <article class="hub glow-card hub--telegram">
        <span class="hub__icon"><Icon name="telegram" size={30} /></span>
        <h2 class="h2">Telegram</h2>
        {telegramMembers > 0 && <p class="hub__stat mono">{formatNumber(telegramMembers)} subscribers</p>}
        <p class="muted">News only. One post per story, with a link to the full summary here. Turn on notifications and you'll hear it first.</p>
        <a class="btn btn--lg btn--ghost" href={settings.socials.telegram} target="_blank" rel="noopener noreferrer" data-magnetic>
          <Icon name="telegram" /> Get news alerts
        </a>
      </article>
    </div>
  </section>

  {
    settings.discordServerId && (
      <section class="wrap section">
        <div class="widget" data-reveal>
          <iframe
            src={`https://discord.com/widget?id=${settings.discordServerId}&theme=dark`}
            title="Discord server widget"
            width="350"
            height="420"
            loading="lazy"
            sandbox="allow-popups allow-popups-to-escape-sandbox allow-same-origin allow-scripts"
          />
        </div>
      </section>
    )
  }

  <section class="wrap section">
    <SectionHead eyebrow="Inside the server" title="The" accent="channels" />
    <div class="grid grid--3" data-reveal-group>
      {
        channels.map((c) => (
          <div class="chan glow-card">
            <span class="chan__name mono">{c.name}</span>
            <p class="muted">{c.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="wrap section">
    <div class="rules glow-card glow-card--static" data-reveal>
      <div>
        <p class="eyebrow">House rules</p>
        <h2 class="h2">Spoiler-safe <span class="grad-text">launch</span></h2>
      </div>
      <ol class="rules__list">
        {rules.map((r) => <li>{r}</li>)}
      </ol>
    </div>
  </section>
</BaseLayout>

<style>
  .duo-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: clamp(1rem, 2.4vw, 1.5rem); }
  .hub { padding: clamp(1.6rem, 4vw, 2.5rem); display: grid; gap: 0.9rem; justify-items: start; }
  .hub__icon {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 18px;
    color: #fff;
  }
  .hub--discord .hub__icon { background: linear-gradient(135deg, #5865f2, #7b5cff); box-shadow: 0 14px 36px -12px rgba(123, 92, 255, 0.8); }
  .hub--telegram .hub__icon { background: linear-gradient(135deg, #22e4d9, #229ed9); box-shadow: 0 14px 36px -12px rgba(34, 228, 217, 0.7); }
  .hub__stat { font-size: 0.8rem; letter-spacing: 0.1em; color: var(--sun); }
  .widget { display: flex; justify-content: center; }
  .widget iframe { border: 0; border-radius: var(--radius); }
  .chan { padding: 1.25rem 1.3rem; display: grid; gap: 0.4rem; }
  .chan__name { color: var(--pink-hot); font-size: 1rem; }
  .rules {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 2rem;
    padding: clamp(1.6rem, 4vw, 2.75rem);
    align-items: center;
  }
  .rules__list { display: grid; gap: 0.8rem; padding-left: 1.3rem; color: var(--text-dim); }
  .rules__list li::marker { color: var(--sun); font-family: var(--font-mono); }
  @media (max-width: 820px) {
    .duo-grid, .rules { grid-template-columns: 1fr; }
  }
</style>
