---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EmptyState from "../../components/EmptyState.astro";
import PageHead from "../../components/PageHead.astro";
import PostCard from "../../components/PostCard.astro";
import Icon from "../../components/Icon.astro";
import { getPosts } from "../../lib/content";

const posts = await getPosts("tips");
---

<BaseLayout title="GTA 6 Tips & Tricks" description="Quick GTA 6 tips and tricks for console players: settings, storage, money and launch-week survival.">
  <PageHead eyebrow="Tips & Tricks" title="Quick" accent="wins" lead="Short, practical GTA 6 tips you can use in five minutes or less.">
    <a class="link-arrow" href="/guides/">All guides &amp; tips <Icon name="arrow" size={16} /></a>
  </PageHead>
  <section class="wrap section" style="padding-top: 0">
    {
      posts.length ? (
        <div class="grid grid--3" data-reveal-group>
          {posts.map((post) => (
            <PostCard post={post} morph headingLevel="h2" />
          ))}
        </div>
      ) : (
        <EmptyState title="No tips yet" text="The first tips are on their way." />
      )
    }
  </section>
</BaseLayout>
